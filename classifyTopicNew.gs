 if(cache){try{const hit=cache.get(key);if(hit){const data=JSON.parse(hit);checkedCalendar(data,start,end,israel);return data;}}catch(err){/* Refetch corrupt/evicted cache. */}}
 const url='https://www.hebcal.com/hebcal?v=1&cfg=json&s=on&maj=on&min=on&mf=on&lg=s&leyning=off&i='+(israel?'on':'off')+'&start='+start+'&end='+end;
 const response=UrlFetchApp.fetch(url,{muteHttpExceptions:true});
 if(response.getResponseCode()!==200)throw new Error('Hebcal HTTP '+response.getResponseCode());
 const data=JSON.parse(response.getContentText());checkedCalendar(data,start,end,israel);
 if(cache){try{const encoded=JSON.stringify(data);if(Utilities.newBlob(encoded).getBytes().length<95000)cache.put(key,encoded,21600);}catch(err){/* Calendar still valid without cache. */}}
 return data;
}
